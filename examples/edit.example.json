     "transition": {"type": "whip", "duration": 0.3}},
    {"src": "work/test/broll.mp4", "in": 1.0, "out": 3.0, "speed": 1.5, "zoom": "punch", "grade": "vivid",
     "transition": {"type": "flash", "duration": 0.15}},
    {"src": "work/test/talk.mp4", "in": 3.6, "out": 8.6, "zoom": {"from": 1.15, "to": 1.15},
